<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\WinBox.Abstractions\WinBox.Abstractions.csproj" />
    <ProjectReference Include="..\..\plugins\search\WinBox.Search\WinBox.Search.csproj" />
    <ProjectReference Include="..\..\plugins\toolbox\WinBox.Toolbox\WinBox.Toolbox.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Debug: console for make run / logs. Release+dist: quiet WinExe tray resident. -->
    <OutputType>Exe</OutputType>
    <OutputType Condition="'$(Configuration)' != 'Debug'">WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Avoid launching the native apphost .exe (often blocked as Access Denied by AV / policy). -->
    <UseAppHost>false</UseAppHost>
    <!-- Win32 PE icon for Explorer / Start / Apps list when UseAppHost=true (make dist). -->
    <ApplicationIcon>Assets\winbox.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Keep WinForms out of global usings so WPF TextBox/ListBox/Application stay unambiguous. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Remove="System.Drawing.Imaging" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WinBox.Host.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\winbox.ico" Condition="Exists('Assets\winbox.ico')" />
  </ItemGroup>

</Project>
